<Window
    x:Class="AiGoofish.Launcher.App.MainWindow"
    x:DataType="local:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AiGoofish.Launcher.App"
    Title="闲鱼监控与 AI 推荐 · Launcher"
    Width="1120" Height="760" MinWidth="920" MinHeight="640"
    Background="#FAF8F3" Foreground="#292638"
    FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="LauncherSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LauncherBorderBrush" Color="#E9E4DB" />
    <SolidColorBrush x:Key="LauncherTextBrush" Color="#292638" />
    <SolidColorBrush x:Key="LauncherMutedBrush" Color="#777181" />
    <SolidColorBrush x:Key="LauncherPrimaryBrush" Color="#6D4BE8" />
    <SolidColorBrush x:Key="LauncherPrimaryTintBrush" Color="#F0EBFF" />
    <LinearGradientBrush x:Key="LauncherActionBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#8B5CF6" Offset="0" />
      <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>
    <StreamGeometry x:Key="playIcon">M 6,3 L 21,12 L 6,21 Z</StreamGeometry>
    <StreamGeometry x:Key="slidersIcon">M 3,6 H 21 M 3,12 H 21 M 3,18 H 21 M 8,3 V 9 M 16,9 V 15 M 10,15 V 21</StreamGeometry>
    <StreamGeometry x:Key="aiIcon">M 5,5 H 19 V 19 H 5 Z M 9,1 V 5 M 15,1 V 5 M 9,19 V 23 M 15,19 V 23 M 1,9 H 5 M 1,15 H 5 M 19,9 H 23 M 19,15 H 23 M 9,9 H 15 V 15 H 9 Z</StreamGeometry>
    <StreamGeometry x:Key="shieldIcon">M 12,2 L 21,6 V 12 C 21,17 17,21 12,23 C 7,21 3,17 3,12 V 6 Z M 12,7 V 15 M 8,11 H 16</StreamGeometry>
    <StreamGeometry x:Key="logsIcon">M 3,3 H 21 V 21 H 3 Z M 7,8 H 17 M 7,12 H 17 M 7,16 H 14</StreamGeometry>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.action-footer">
      <Setter Property="Background" Value="#FFFDFA" />
      <Setter Property="BorderBrush" Value="{StaticResource LauncherBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="22,12" />
    </Style>
    <Style Selector="Border.action-footer.overview">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="26,18,26,24" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource LauncherSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LauncherBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #06000000" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource LauncherTextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource LauncherMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.validation-error">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#A61B1B" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="{StaticResource LauncherActionBrush}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#514B61" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource LauncherBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F5F1FF" />
      <Setter Property="BorderBrush" Value="#C9B9F5" />
    </Style>
    <Style Selector="Button.log-tab.selected">
      <Setter Property="Background" Value="{StaticResource LauncherPrimaryTintBrush}" />
      <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="#C9B9F5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="72" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource LauncherMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#F3EEE6" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{StaticResource LauncherPrimaryTintBrush}" />
      <Setter Property="Foreground" Value="#6441CF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Path.nav-icon, Path.line-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="#81768F" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav.selected Path.nav-icon">
      <Setter Property="Stroke" Value="{StaticResource LauncherPrimaryBrush}" />
    </Style>
    <Style Selector="WrapPanel Button">
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="Foreground" Value="#AC3636" />
      <Setter Property="Background" Value="#FFF4F4" />
      <Setter Property="BorderBrush" Value="#EDD0D0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource LauncherPrimaryBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6D4BE8" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5836C7" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E7E0F4" />
      <Setter Property="Foreground" Value="#766987" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E8DFFF" />
      <Setter Property="Foreground" Value="#6441CF" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="106,*">
    <Border Background="#FFFCF5" BorderBrush="#EBE5D9" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="7,20,7,16">
        <StackPanel Spacing="7" HorizontalAlignment="Center">
          <Border CornerRadius="15" ClipToBounds="True" Width="52" Height="52" BoxShadow="0 4 12 0 #1AD3A52E">
            <Image x:Name="BrandLogo" Source="avares://AiGoofish.Launcher.App/Assets/brand-logo.png" />
          </Border>
          <TextBlock Text="闲鱼监控" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LauncherTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,30,0,0" Spacing="8">

          <Button x:Name="OverviewNavigationButton" Classes="nav" Classes.selected="{Binding IsOverviewPage}" Tag="Overview" Click="OnNavigationClick" AutomationProperties.Name="首页">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Path Classes="nav-icon" Data="{StaticResource playIcon}" />
              <TextBlock Text="首页" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="AiNavigationButton" Classes="nav" Classes.selected="{Binding IsAiPage}" Tag="Ai" Click="OnNavigationClick" AutomationProperties.Name="AI 连接">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Path Classes="nav-icon" Data="{StaticResource aiIcon}" />
              <TextBlock Text="AI 连接" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="DiagnosticsNavigationButton" Classes="nav" Classes.selected="{Binding IsDiagnosticsPage}" Tag="Diagnostics" Click="OnNavigationClick" AutomationProperties.Name="诊断备份">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Path Classes="nav-icon" Data="{StaticResource shieldIcon}" />
              <TextBlock Text="诊断备份" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">

          <Button x:Name="LogsNavigationButton" Classes="nav" Classes.selected="{Binding IsLogsPage}" Tag="Logs" Click="OnNavigationClick" AutomationProperties.Name="运行日志">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Path Classes="nav-icon" Data="{StaticResource logsIcon}" />
              <TextBlock Text="运行日志" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="SettingsNavigationButton" Classes="nav" Classes.selected="{Binding IsSettingsPage}" Tag="Settings" Click="OnNavigationClick" AutomationProperties.Name="设置">
            <StackPanel Spacing="9" HorizontalAlignment="Center">
              <Path Classes="nav-icon" Data="{StaticResource slidersIcon}" />
              <TextBlock Text="设置" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Background="#FFFDFA" BorderBrush="{StaticResource LauncherBorderBrush}" BorderThickness="0,0,0,1" Padding="28,15">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="Medium" Foreground="{StaticResource LauncherTextBrush}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border IsVisible="{Binding IsSimulation}" Background="#F1EBFF" CornerRadius="8" Padding="9,4">
              <TextBlock Text="{Binding ModeBadge}" FontSize="11" Foreground="#705799" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="26,20,26,18">
        <ScrollViewer x:Name="OverviewPage" IsVisible="{Binding IsOverviewPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">
            <Border Height="152" CornerRadius="20" ClipToBounds="True" Background="#FFE57A">
              <Grid>
                <Image x:Name="BrandBackground" Source="avares://AiGoofish.Launcher.App/Assets/brand-background.png" Width="350" HorizontalAlignment="Right" Stretch="UniformToFill">
                  <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Color="Transparent" Offset="0" />
                      <GradientStop Color="White" Offset="0.32" />
                    </LinearGradientBrush>
                  </Image.OpacityMask>
                </Image>
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Color="#FFF5CC" Offset="0" />
                      <GradientStop Color="#FFF0B6" Offset="0.48" />
                      <GradientStop Color="#00FFE57A" Offset="0.78" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel Margin="26,20" Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Text="闲鱼监控 · AI 推荐" FontSize="29" FontWeight="SemiBold" Foreground="#30293B" />
                  <TextBlock Text="让值得关注的好物，及时出现在眼前" FontSize="13" Foreground="#756345" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="card" Padding="24">
              <StackPanel Spacing="12">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <Ellipse Width="9" Height="9" Fill="{Binding StatusAccentBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ServiceState}" FontSize="19" FontWeight="Medium" Foreground="#243449" />
                    </StackPanel>
                    <TextBlock Text="{Binding PhaseMessage}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                <Border IsVisible="{Binding SetupRequired}" Background="#FFF7DE" CornerRadius="9" Padding="12,9">
                  <TextBlock Text="{Binding SetupHelp}" FontSize="12" Foreground="#826626" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="20,12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="本机健康" Classes="section-title" />
                  <Button Grid.Column="1" Classes="secondary" Content="查看诊断" Padding="10,5" Tag="Diagnostics" Click="OnNavigationClick" />
                </Grid>
                <ItemsControl x:Name="OverviewHealthComponents" ItemsSource="{Binding Components}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ComponentStatusRow">
                      <StackPanel Spacing="5" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" Classes="muted" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                  <TextBlock Text="{Binding ManagementUrl}" FontFamily="Consolas" Classes="muted" Margin="0,0,16,0" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding FreshnessText}" Classes="muted" TextWrapping="Wrap" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsSettingsPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="4">
                  <TextBlock Text="启动后打开管理页" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <ToggleSwitch x:Name="OpenManagementPagePreferenceCheckBox" Grid.Column="1" OnContent="" OffContent="" MinWidth="48"
                          IsChecked="{Binding OpenManagementPageOnReady, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditLauncherPreferences}"
                          VerticalAlignment="Center" AutomationProperties.Name="服务就绪后打开管理页" />
              </Grid>
              <Border Background="#E9EDF2" Height="1" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="4">
                  <TextBlock Text="打开启动器时启动服务" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="仅适用于已初始化且安全停止的服务，不会设置系统开机自启。" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="AutoStartPreferenceCheckBox" Grid.Column="1" OnContent="" OffContent="" MinWidth="48"
                          IsChecked="{Binding AutoStartOnLauncherOpen, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditLauncherPreferences}"
                          VerticalAlignment="Center" AutomationProperties.Name="打开 Launcher 时启动服务" />
              </Grid>
              <TextBlock x:Name="LauncherPreferencesStatusTextBlock" Classes="muted" Text="{Binding LauncherPreferencesStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border x:Name="WebPortSettingsCard" IsVisible="{Binding HasWebPortPanel}" Classes="card">
            <StackPanel Spacing="9">
              <TextBlock Classes="section-title" Text="本机 Web 端口" />
              <CheckBox x:Name="AutomaticWebPortCheckBox" Content="自动选择端口" IsChecked="{Binding AutomaticWebPort, Mode=TwoWay}" IsEnabled="{Binding CanStageWebPort}" />
              <TextBlock Classes="muted" Text="自动模式优先复用上次端口；取消勾选可指定固定端口。" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="保存不会立即切换端口。停止服务后才能应用；应用会启动服务，失败时尝试恢复原地址。" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Classes="muted" Text="当前生效" />
                  <TextBlock x:Name="EffectiveWebPortTextBlock" Text="{Binding EffectiveWebPortText}" FontFamily="Consolas" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="muted" Text="待应用" />
                  <TextBlock x:Name="PendingWebPortTextBlock" Text="{Binding PendingWebPortText}" FontFamily="Consolas" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Classes="muted" Text="指定端口" />
                  <TextBox x:Name="WebPortTextBox" Text="{Binding WebPortInput, Mode=TwoWay}" IsEnabled="{Binding CanEnterWebPort}" PlaceholderText="1024–65535" TabIndex="2" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="WebPortErrorTextBlock" Classes="validation-error" Text="{Binding WebPortError}" IsVisible="{Binding HasWebPortError}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StageWebPortButton" Classes="secondary" Content="保存设置" IsEnabled="{Binding CanStageWebPort}" Click="OnWebPortStageClick" TabIndex="3" />
                <Button x:Name="ApplyWebPortButton" Classes="primary" Content="应用并启动" IsEnabled="{Binding CanApplyWebPort}" Click="OnWebPortApplyClick" TabIndex="4" />
              </StackPanel>
              <TextBlock x:Name="WebPortStatusTextBlock" Classes="muted" Text="{Binding WebPortStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Button x:Name="DataDirectoryShortcutButton" Classes="secondary" Content="打开数据目录" Click="OnOpenDataClick" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsAiPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
          <Border IsVisible="{Binding !BusinessConnection.IsConfigurationVisible}" Background="#EDF4FA" CornerRadius="10" Padding="24">
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="36,*" ColumnSpacing="14">
                <Path Classes="line-icon" Data="{StaticResource aiIcon}" Width="30" Height="30" Stroke="#0875C1" />
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="连接你的 AI 服务" FontSize="22" Foreground="#25445E" />
                  <TextBlock Text="完成账号连接后，在这里管理默认模型、密钥和连接状态。" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <StackPanel Spacing="5">
                  <TextBlock Text="01  启动本地服务" FontSize="14" Foreground="#25445E" />
                  <TextBlock Text="在首页点击一键启动" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="02  登录管理页面" FontSize="14" Foreground="#25445E" />
                  <TextBlock Text="首次使用先创建管理员" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                  <TextBlock Text="03  连接当前账号" FontSize="14" Foreground="#25445E" />
                  <TextBlock Text="发起配对，在 Web 中授权" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title" Text="当前账号与 AI 连接" />
                <TextBlock Classes="muted" Text="编辑已授权用户的默认 AI 配置，不影响其他用户或任务指定的其他模型。保存不调用 AI。" TextWrapping="Wrap" />
              </StackPanel>

              <TextBlock Classes="muted" Text="{Binding BusinessConnection.Status}" TextWrapping="Wrap" />

              <WrapPanel IsVisible="{Binding BusinessConnection.HostReady}">
                <Button x:Name="BusinessPairingButton" Classes="secondary" Content="开始账号配对" IsEnabled="{Binding BusinessConnection.CanBeginPairing}" Click="OnBusinessPairingClick" TabIndex="2" />
                <Button Classes="secondary" Content="取消配对" IsVisible="{Binding BusinessConnection.CanCancelPairing}" IsEnabled="{Binding BusinessConnection.CanCancelPairing}" Click="OnBusinessPairingCancelClick" TabIndex="3" />
                <Button Classes="secondary" Content="退出当前账号" IsVisible="{Binding BusinessConnection.CanLogout}" IsEnabled="{Binding BusinessConnection.CanLogout}" Click="OnBusinessLogoutClick" TabIndex="4" />
                <Button x:Name="SwitchBusinessAccountButton" Classes="secondary" Content="切换账号" IsVisible="{Binding BusinessConnection.CanLogout}" IsEnabled="{Binding BusinessConnection.CanLogout}" Click="OnSwitchBusinessAccountClick" />
              </WrapPanel>

              <Border IsVisible="{Binding BusinessConnection.IsPairingCodeVisible}" Padding="12" Background="#F5F7FA" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="请在已登录的 Web 页面手动输入此配对码，并核对账号与设备后明确批准。" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding BusinessConnection.PairingCode}" FontFamily="Consolas" FontSize="23" FontWeight="Bold" LetterSpacing="2" Foreground="#173F80" />
                  <TextBlock Text="{Binding BusinessConnection.PairingExpiry}" Classes="muted" />
                </StackPanel>
              </Border>

              <StackPanel IsVisible="{Binding BusinessConnection.IsConfigurationVisible}" Spacing="9">
                <TextBlock Text="{Binding BusinessConnection.AccountSummary}" FontWeight="SemiBold" Foreground="#24334A" TextWrapping="Wrap" />
                <TextBlock Text="浏览器换号不会自动切换此处账号；切换时请在授权页核对用户名。" Classes="muted" TextWrapping="Wrap" />
                <Button x:Name="BusinessValidationSummaryButton" Classes="secondary" IsVisible="{Binding BusinessConnection.HasValidationErrors}" Click="OnBusinessValidationSummaryClick" TabIndex="5" HorizontalContentAlignment="Left">
                  <TextBlock Text="{Binding BusinessConnection.ValidationSummary}" TextWrapping="Wrap" />
                </Button>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                    <TextBlock Text="默认 Base URL" Classes="muted" />
                    <TextBox x:Name="BusinessBaseUrlTextBox" Text="{Binding BusinessConnection.BaseUrl, Mode=TwoWay}" IsEnabled="{Binding BusinessConnection.IsBaseUrlEditable}" PlaceholderText="https://api.example.com/v1" TabIndex="6" />
                    <TextBlock x:Name="BusinessBaseUrlErrorTextBlock" Classes="validation-error" Text="{Binding BusinessConnection.BaseUrlError}" IsVisible="{Binding BusinessConnection.HasBaseUrlError}" />
                    <TextBlock IsVisible="{Binding BusinessConnection.IsBaseUrlRedacted}" Text="地址因包含敏感部分而隐藏；请到 Web 系统调整。" FontSize="12" Foreground="#8A5A00" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                    <TextBlock Text="默认模型名称" Classes="muted" />
                    <TextBox x:Name="BusinessModelNameTextBox" Text="{Binding BusinessConnection.ModelName, Mode=TwoWay}" IsEnabled="{Binding BusinessConnection.IsModelEditable}" PlaceholderText="模型名称" TabIndex="7" />
                    <TextBlock x:Name="BusinessModelNameErrorTextBlock" Classes="validation-error" Text="{Binding BusinessConnection.ModelNameError}" IsVisible="{Binding BusinessConnection.HasModelNameError}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                    <TextBlock Text="API Key" Classes="muted" />
                    <TextBox x:Name="BusinessApiKeyTextBox" Text="{Binding BusinessConnection.ApiKeyDraft, Mode=TwoWay}" PasswordChar="●" IsEnabled="{Binding BusinessConnection.IsApiKeyEditable}" PlaceholderText="留空表示不变；输入新 Key 以替换" TabIndex="8" />
                    <TextBlock x:Name="BusinessApiKeyErrorTextBlock" Classes="validation-error" Text="{Binding BusinessConnection.ApiKeyError}" IsVisible="{Binding BusinessConnection.HasApiKeyError}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                    <TextBlock Text="密钥状态" Classes="muted" />
                    <TextBlock Text="{Binding BusinessConnection.KeyState}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                    <TextBlock Text="配置来源" Classes="muted" />
                    <TextBlock Text="{Binding BusinessConnection.ConfigSource}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                    <TextBlock Text="配置版本" Classes="muted" />
                    <TextBlock Text="{Binding BusinessConnection.ConfigRevisionText}" />
                  </StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="3">
                    <TextBlock Text="实际生效状态" Classes="muted" />
                    <TextBlock Text="{Binding BusinessConnection.EffectiveState}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <Expander x:Name="AiAdvancedParameters" Header="高级参数 · 当前账号默认配置" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="输出 tokens 字段名" Classes="muted" />
                        <TextBox x:Name="AiTokensParameter" Text="{Binding BusinessConnection.TokensParameter, Mode=TwoWay}" PlaceholderText="如 max_tokens，可留空" IsEnabled="{Binding BusinessConnection.IsModelEditable}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="输出 tokens 上限" Classes="muted" />
                        <TextBox x:Name="AiTokensLimit" Text="{Binding BusinessConnection.TokensLimit, Mode=TwoWay}" IsEnabled="{Binding BusinessConnection.IsModelEditable}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="字段名留空时不发送输出长度参数；上限未设置时使用 20000。按模型支持情况填写，保存后再测试。" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="thinking、JSON 格式和图像输入开关尚未完成用户级隔离，本页不修改这些全局设置。" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
                <TextBlock IsVisible="{Binding BusinessConnection.HasAdvancedDraft}" Text="高级参数尚未保存；保存后才能手动测试 AI。" Foreground="#956600" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Classes="primary" Content="保存当前账号配置" IsEnabled="{Binding BusinessConnection.CanSave}" Click="OnBusinessAiSaveClick" TabIndex="9" />
                  <Button Classes="secondary" Content="移除 API Key" IsEnabled="{Binding BusinessConnection.CanRemoveApiKey}" Click="OnBusinessApiKeyRemoveClick" TabIndex="10" />
                  <Button Classes="secondary" Content="重新读取配置" IsEnabled="{Binding BusinessConnection.CanRefreshConfiguration}" Click="OnBusinessAiRefreshClick" TabIndex="11" />
                  <Button Classes="secondary" Content="Web 高级设置" Click="OnAdvancedClick" TabIndex="12" />
                </WrapPanel>
                <Border Padding="12" Background="#F5F7FA" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8">
                  <StackPanel Spacing="5">
                    <TextBlock Text="当前配置检测状态 · 读取缓存不产生调用" FontWeight="SemiBold" Foreground="#24334A" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <TextBlock Text="{Binding BusinessConnection.HealthFreshnessText}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding BusinessConnection.HealthCategoryText}" FontWeight="SemiBold" Foreground="#24334A" />
                    </Grid>
                    <TextBlock Text="{Binding BusinessConnection.HealthMessage}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BusinessConnection.HealthObservedText}" FontSize="12" Foreground="#596A7F" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BusinessConnection.HealthSourceText}" FontSize="12" Foreground="#596A7F" />
                    <Button x:Name="RefreshAiHealthButton" Classes="secondary" Content="读取健康缓存" IsEnabled="{Binding BusinessConnection.CanRefreshAiHealth}" Click="OnBusinessAiHealthRefreshClick" TabIndex="13" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <WrapPanel>
                  <Button x:Name="CheckAiConfigurationButton" Classes="secondary" Content="检查配置（仅本地，不联网）" IsEnabled="{Binding BusinessConnection.CanCheckConfiguration}" Click="OnBusinessAiCheckClick" TabIndex="14" />
                  <Button x:Name="ManualAiTestButton" Classes="secondary" Content="手动测试 AI（可能产生费用）" IsEnabled="{Binding BusinessConnection.CanRunManualTest}" Click="OnBusinessManualAiTestClick" TabIndex="15" />
                  <Button x:Name="CancelManualAiTestButton" Classes="secondary" Content="取消等待（结果可能未知）" IsVisible="{Binding BusinessConnection.CanCancelManualTest}" IsEnabled="{Binding BusinessConnection.CanCancelManualTest}" Click="OnBusinessManualAiTestCancelClick" TabIndex="16" />
                </WrapPanel>

                <Border IsVisible="{Binding BusinessConnection.ShowManualTestStatus}" Padding="12" Background="#F5F7FA" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="手动 AI 测试结果（仅当前账号与 Launcher 窗口）" FontWeight="SemiBold" Foreground="#24334A" />
                    <TextBlock Text="{Binding BusinessConnection.ManualTestSource}" Classes="muted" />
                    <TextBlock Text="{Binding BusinessConnection.ManualTestMessage}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <TextBlock Text="{Binding BusinessConnection.ManualTestTime}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding BusinessConnection.ManualTestLatency}" Classes="muted" />
                    </Grid>
                    <TextBlock IsVisible="{Binding BusinessConnection.IsManualTestUnknown}" Text="结果未知可能表示服务端已处理或计费；系统不会自动重试。若要重测，须重新选择配置并确认。" Foreground="#8A5A00" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsDiagnosticsPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14">
            <Border Background="{Binding PromptBackground}" BorderBrush="{Binding PromptBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding ServiceState}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding PromptForeground}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ServiceDetail}" FontSize="13" Foreground="{Binding PromptForeground}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PhaseMessage}" FontSize="13" Foreground="{Binding PromptForeground}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="备份与恢复" />
                <TextBlock Classes="muted" Text="操作需要停止服务；恢复完成后请手动启动。请妥善保管备份口令，遗失后无法恢复。" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="BusinessBackupButton" Classes="secondary" Content="创建备份" IsEnabled="{Binding CanCreateBusinessBackup}" Click="OnBusinessBackupClick" TabIndex="19" />
                  <Button x:Name="SchemaUpgradeButton" Classes="secondary" Content="备份并升级数据" IsEnabled="{Binding CanUpgradeSchema}" Click="OnSchemaUpgradeClick" TabIndex="20" />
                  <Button x:Name="BusinessRestoreButton" Classes="secondary" Content="恢复备份" IsEnabled="{Binding CanRestoreBusinessBackup}" Click="OnBusinessRestoreClick" TabIndex="21" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="组件状态" />
                <ItemsControl x:Name="DiagnosticComponents" ItemsSource="{Binding Components}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ComponentStatusRow">
                      <StackPanel Margin="0,0,12,0" Spacing="4">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#3A4B5E" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#657181" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" Text="{Binding ObservationSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding FreshnessText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="DiagnosticExportButton" Classes="secondary" Content="预览诊断报告" IsEnabled="{Binding CanExportDiagnostic}" Click="OnDiagnosticClick" TabIndex="22" />
                  <Button Classes="secondary" Content="刷新状态" Click="OnRefreshClick" TabIndex="23" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsLogsPage}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
          <Border Classes="card" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding ServiceState}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="启动器运行记录" Classes="muted" />
              </StackPanel>
              <WrapPanel Grid.Column="1" MaxWidth="570" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="LogsDiagnosticButton" Classes="secondary" Content="诊断报告" IsEnabled="{Binding CanExportDiagnostic}" Click="OnDiagnosticClick" />
                <Button x:Name="LogsCancelRestoreButton" Classes="secondary" Content="取消恢复" IsVisible="{Binding CanCancelBusinessRestore}" IsEnabled="{Binding CanCancelBusinessRestore}" Click="OnCancelRestoreClick" />
                <Button x:Name="LogsCancelButton" Classes="secondary" Content="安全取消" IsVisible="{Binding IsCancelEnabled}" IsEnabled="{Binding IsCancelEnabled}" Click="OnCancelClick" />
                <Button x:Name="LogsStopButton" Classes="danger" Content="停止服务" IsVisible="{Binding IsStopEnabled}" IsEnabled="{Binding IsStopEnabled}" Click="OnStopClick" />
                <Button x:Name="LogsPrimaryButton" Classes="primary" MinWidth="188" HorizontalContentAlignment="Center" Content="{Binding DisplayPrimaryButtonText}" IsEnabled="{Binding IsPrimaryEnabled}" Click="OnPrimaryClick" />
              </WrapPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="ActivityViewButton" Classes="secondary log-tab" Classes.selected="{Binding IsActivityView}" Content="活动摘要" Click="OnActivityViewClick" />
              <Button x:Name="RawLogViewButton" Classes="secondary log-tab" Classes.selected="{Binding IsRawLogView}" Content="原始日志" Click="OnRawLogViewClick" />
            </StackPanel>
            <Button x:Name="LogsDirectoryShortcutButton" Grid.Column="1" Classes="secondary" Content="打开日志目录" Click="OnOpenLogsClick" />
          </Grid>
          <StackPanel Grid.Row="2" Spacing="4">
            <WrapPanel>
              <ComboBox x:Name="LogLevelFilter" SelectedIndex="{Binding LogView.LevelIndex, Mode=TwoWay}" MinWidth="140" Margin="0,0,8,8" AutomationProperties.Name="日志级别">
                <ComboBoxItem Content="全部级别" /><ComboBoxItem Content="警告与错误" /><ComboBoxItem Content="仅错误" />
              </ComboBox>
              <Button x:Name="PauseLogViewButton" Classes="secondary" Content="{Binding LogView.PauseLabel}" Click="OnPauseLogsClick" />
              <Button x:Name="ExportLogViewButton" Classes="secondary" Content="导出当前视图" Click="OnExportLogViewClick" />
            </WrapPanel>
            <TextBlock Text="{Binding LogView.Status}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Border x:Name="ActivityPanel" Grid.Row="3" IsVisible="{Binding IsActivityView}" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Margin="18,14" Text="启动器活动 · 最近 100 条" Classes="muted" />
              <ListBox x:Name="ActivityList" Grid.Row="1" ItemsSource="{Binding LogView.Activities}" Background="Transparent" BorderThickness="0" Padding="12,0,12,12" IsTextSearchEnabled="False">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LogRow">
                    <Border BorderBrush="#EEE9F1" BorderThickness="0,0,0,1" Padding="6,12">
                      <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Time}" FontFamily="Consolas" Classes="muted" />
                          <TextBlock Text="{Binding Component}" Classes="muted" />
                          <TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="ActivityEmptyState" Grid.Row="1" IsVisible="{Binding !LogView.HasActivities}" Text="暂无匹配的启动器活动" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border x:Name="RawLogPanel" Grid.Row="3" IsVisible="{Binding IsRawLogView}" Background="#101827" BorderBrush="#29364B" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Margin="18,14" Text="最近 300 条 · 只读" FontSize="12" Foreground="#C5D0DF" />
            <ListBox x:Name="RawLogList" Grid.Row="1" ItemsSource="{Binding LogView.Logs}" Background="Transparent" BorderThickness="0" Padding="12" IsTextSearchEnabled="False">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:LogRow">
                  <Grid ColumnDefinitions="62,50,100,*" Margin="0,3">
                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" Foreground="#AAB8CA" />
                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" Foreground="#D6DFEA" />
                    <TextBlock Grid.Column="2" Text="{Binding Component}" FontSize="12" Foreground="#9ABCF7" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12" Foreground="#F0F4F9" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              <TextBlock x:Name="RawLogEmptyState" Grid.Row="1" IsVisible="{Binding !LogView.HasLogs}" Text="暂无匹配的日志输出" FontSize="13" Foreground="#AAB8CA" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border x:Name="ActionFooter" Classes="action-footer" Classes.overview="{Binding IsOverviewPage}" IsVisible="{Binding !IsLogsPage}" Grid.Row="2">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="9">
          <StackPanel IsVisible="{Binding !IsOverviewPage}" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding ServiceState}" FontSize="13" FontWeight="SemiBold" Foreground="#344458" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="CancelRestoreButton" Grid.Column="1" Classes="secondary" Content="取消恢复" IsVisible="{Binding CanCancelBusinessRestore}" IsEnabled="{Binding CanCancelBusinessRestore}" Click="OnCancelRestoreClick" TabIndex="21" />
          <Button x:Name="CancelButton" Grid.Column="2" Classes="secondary" Content="安全取消" IsVisible="{Binding IsCancelEnabled}" IsEnabled="{Binding IsCancelEnabled}" Click="OnCancelClick" TabIndex="25" />
          <Button x:Name="StopButton" Grid.Column="3" Classes="danger" Content="停止服务" IsVisible="{Binding IsStopEnabled}" IsEnabled="{Binding IsStopEnabled}" Click="OnStopClick" TabIndex="26" />
          <Button x:Name="PrimaryButton" Grid.Column="4" Classes="primary" IsVisible="{Binding IsOverviewPage}" MinWidth="232" MinHeight="64" FontSize="20" HorizontalContentAlignment="Center" Content="{Binding DisplayPrimaryButtonText}" IsEnabled="{Binding IsPrimaryEnabled}" Click="OnPrimaryClick" TabIndex="27" />
          <Button x:Name="FooterPrimaryButton" Grid.Column="4" Classes="primary" IsVisible="{Binding !IsOverviewPage}" MinWidth="188" MinHeight="48" FontSize="16" Content="{Binding DisplayPrimaryButtonText}" IsEnabled="{Binding IsPrimaryEnabled}" Click="OnPrimaryClick" TabIndex="27" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
